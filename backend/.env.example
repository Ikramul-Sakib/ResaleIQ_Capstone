# Copy this file to backend/.env and fill in the values you need.

# development | production
APP_ENV=development

# Long random string used to sign login tokens. REQUIRED in production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Port used by `python run.py`
PORT=8000

# Frontend address(es) allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used to build password-reset links
FRONTEND_URL=http://localhost:5173

# First administrator account, created automatically on first run
ADMIN_EMAIL=admin@resaleiq.local
ADMIN_PASSWORD=Admin@12345

# Optional: where the SQLite file and uploaded photos are stored
# DATABASE_PATH=instance/resaleiq.db
# UPLOAD_FOLDER=uploads

# --- AI price estimation (Google Gemini) ---
# Leave GEMINI_API_KEY empty to use the built-in rule-based estimator.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
AI_ESTIMATES_PER_HOUR=30
